# Window rules — prefer app_id (Wayland-native) over class (XWayland only).

# Transparent terminal; scroll's decoration keeps it clean.
for_window [app_id="Alacritty"] opacity 0.90

# Float the usual dialogs / tools.
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="thunar" title="File Operation Progress"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

# Keep video full-screen from idling the screen.
for_window [app_id="firefox"] inhibit_idle fullscreen
for_window [app_id="mpv"] inhibit_idle fullscreen
